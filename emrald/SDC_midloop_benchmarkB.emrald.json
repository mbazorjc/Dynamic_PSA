 "ActionList": [
  {
   "id": "d02e64e9-44e2-5d17-938a-6bb74b37510a",
   "name": "upd_Qd",
   "desc": "",
   "actType": "atCngVarVal",
   "mainItem": true,
   "objType": "Action",
   "required": false,
   "mutExcl": true,
   "variableName": "Qd",
   "scriptCode": "double tau = 3600.0*(72.0 + CurTime); return 2.815000e+09*0.066*(Math.Pow(tau,-0.2) - Math.Pow(tau + 4.733640e+07,-0.2));",
   "codeVariables": [],
   "newStates": []
  },
  {
   "id": "a1cc356e-be4f-53fe-badc-816bea54c5b6",
   "name": "upd_Q",
   "desc": "",
   "actType": "atCngVarVal",
   "mainItem": true,
   "objType": "Action",
   "required": false,
   "mutExcl": true,
   "variableName": "Q",
   "scriptCode": "return Math.Min(Math.Max(Qd/(988.0*4181.0*15.0), 0.063), 0.315);",
   "codeVariables": [
    "Qd"
   ],
   "newStates": []
  },
  {
   "id": "808090be-6224-5169-94e1-a42ace1176cb",
   "name": "upd_hc",
   "desc": "",
   "actType": "atCngVarVal",
   "mainItem": true,
   "objType": "Action",
   "required": false,
   "mutExcl": true,
   "variableName": "hc",
   "scriptCode": "double d = 0.3048; double Fr = 4.0*Q/(Math.PI*d*d*Math.Sqrt(9.80665*d)); return 1.657*d*Math.Pow(Fr,0.4)*(1.0 + 0.0);",
   "codeVariables": [
    "Q"
   ],
   "newStates": []
  },
  {
   "id": "23914575-acdf-54b2-afa8-40735ff455d3",
   "name": "upd_h",
   "desc": "",
   "actType": "atCngVarVal",
   "mainItem": true,
   "objType": "Action",
   "required": false,
   "mutExcl": true,
   "variableName": "h",
   "scriptCode": "double phi = Math.Exp(-0.07194444/1.0); double hn = 0.692449 + (h - 0.692449)*phi + 0.0254*Math.Sqrt(1.0 - phi*phi)*MathNet.Numerics.Distributions.Normal.Sample(Rand, 0.0, 1.0); if (Rand.NextDouble() < 1.0 - Math.Exp(-2.149758e-03*0.07194444)) hn -= MathNet.Numerics.Distributions.Exponential.Sample(Rand, 1.0/0.1); return hn;",
   "codeVariables": [
    "h"
   ],
   "newStates": []
  },
  {
   "id": "3cb05777-a3d1-5a1d-9eaa-8ee4ceaf85fc",
   "name": "upd_alpha",
   "desc": "",
   "actType": "atCngVarVal",
   "mainItem": true,
   "objType": "Action",
   "required": false,
   "mutExcl": true,
   "variableName": "alpha",
   "scriptCode": "double x = (hc - h)/hc; return x > 0.0 ? Math.Pow(Math.Min(x, 1.0), 1.0) : 0.0;",
   "codeVariables": [
    "hc",
    "h"
   ],
   "newStates": []
  },
  {
   "id": "b19547e3-fe1f-54ef-8fa6-f04711fc3a98",
   "name": "upd_MH",
   "desc": "",
   "actType": "atCngVarVal",
   "mainItem": true,
   "objType": "Action",
   "required": false,
   "mutExcl": true,
   "variableName": "MH",
   "scriptCode": "double x = (alpha - 0.02)/(0.11499999999999999 - 0.02); x = Math.Min(1.0, Math.Max(0.0, x)); return 1.0 - Math.Pow(x, 2.0);",
   "codeVariables": [
    "alpha"
   ],
   "newStates": []
  },
  {
   "id": "1bcd2c1a-da19-57e6-8dee-35cf744a2e4a",
   "name": "upd_G_A",
   "desc": "",
   "actType": "atCngVarVal",
   "mainItem": true,
   "objType": "Action",
   "required": false,
   "mutExcl": true,
   "variableName": "G_A",
   "scriptCode": "return MH*(130.0 - 231.796422*Q*Q) - (0.0 + 604.686319*Q*Q);",
   "codeVariables": [
    "MH",
    "Q"
   ],
   "newStates": []
  },
  {
   "id": "36d94dfa-d9c2-5a39-bdc7-79844ed7c30c",
